
#include "../BinarySearchTree.h"

inline void size_test(){
    BinarySearchTree<int> bst;
    assert(bst.size() == 0);
    for(int i = 1; i <= 30; ++i){
        bst.insert(i);
    }
    assert(bst.size() == 30);

    for(int i = 15; i <= 30; ++i){
        bst.remove(i);
    }
    assert(bst.size() == 14);

    bst.clear();
    assert(bst.size() == 0);

    std::cout << "size_test passed\n";
}